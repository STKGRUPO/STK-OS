{
  "name": "stk-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "web:dev": "pnpm --filter @stk-os/web dev",
    "web:build": "pnpm --filter @stk-os/web build",
    "web:lint": "pnpm --filter @stk-os/web lint",
    "api:dev": "python -m uvicorn stk_os.main:app --app-dir apps/api/src --reload --host 127.0.0.1 --port 8000",
    "fiscal:dev": "python -m uvicorn stk_fiscal_service.main:app --app-dir apps/fiscal-service/src --reload --host 127.0.0.1 --port 8010",
    "api:lint": "python -m ruff check apps/api/src apps/api/tests scripts",
    "api:format:check": "python -m ruff format --check apps/api/src apps/api/tests scripts",
    "api:test": "python -m pytest apps/api/tests",
    "contracts": "python scripts/export_openapi.py",
    "secret:scan": "python scripts/check_secrets.py",
    "quality": "pnpm api:lint && pnpm api:format:check && pnpm api:test && pnpm web:lint && pnpm web:build && pnpm secret:scan"
  }
}
